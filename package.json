{
  "name": "ultra-software-vala",
  "version": "1.0.0",
  "packageManager": "pnpm@8.0.0",
  "description": "Ultra Enterprise Software Factory - Consolidated Monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --parallel run build",
    "build:ci": "pnpm -r run build:ci",
    "build:analyze": "pnpm -r run build:analyze",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "test:e2e": "pnpm -r run test:e2e",
    "type-check": "pnpm -r run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "ultra:detect": "pnpm -r run monitor:run && pnpm -r run alert:run && pnpm -r run test:db",
    "ultra:fix": "pnpm -r run selfheal:run",
    "ultra:retest": "pnpm -r run test:api && pnpm -r run test:realtime",
    "ultra:loop": "pnpm -r run orchestrator:run"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "prettier": "^3.2.5",
    "typescript": "^5.8.3",
    "turbo": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "typescript": "^5.8.3"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
